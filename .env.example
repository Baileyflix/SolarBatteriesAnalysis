# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Octopus Energy API Configuration
VITE_OCTOPUS_API_KEY=sk_live_your_api_key_here
VITE_OCTOPUS_API_BASE_URL=https://api.octopus.energy

# Solar Irradiance Data API (to be determined)
# Options: NREL PVWatts, NASA POWER, Solcast, etc.
VITE_SOLAR_API_KEY=your_solar_api_key_here
VITE_SOLAR_API_ENDPOINT=https://api.example.com/solar

# Optional: Development settings
VITE_DEV_MODE=true
